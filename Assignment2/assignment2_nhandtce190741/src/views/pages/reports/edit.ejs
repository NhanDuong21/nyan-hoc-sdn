%>
<%- include('../../partials/header') %>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2 class="mb-4">
                        Edit Report
                    </h2>

                    <form action="/reports/edit/<%= report._id %>" method="POST">

                        <div class="mb-3">

                            <label for="title" class="form-label">
                                Title
                            </label>

                            <input type="text" id="title" name="title" class="form-control" value="<%= report.title %>"
                                required>

                        </div>


                        <div class="mb-3">

                            <label for="description" class="form-label">
                                Description
                            </label>

                            <textarea id="description" name="description" class="form-control" rows="4"
                                required><%= report.description %></textarea>

                        </div>


                        <div class="mb-3">

                            <label for="project" class="form-label">
                                Project
                            </label>

                            <input type="text" id="project" name="project" class="form-control"
                                value="<%= report.project || '' %>">

                        </div>


                        <div class="row">

                            <div class="col-md-4 mb-3">

                                <label for="severity" class="form-label">
                                    Severity
                                </label>

                                <select id="severity" name="severity" class="form-select" required>

                                    <option value="low" <%=report.severity==='low' ? 'selected' : '' %>
                                        >
                                        Low
                                    </option>

                                    <option value="medium" <%=report.severity==='medium' ? 'selected' : '' %>
                                        >
                                        Medium
                                    </option>

                                    <option value="high" <%=report.severity==='high' ? 'selected' : '' %>
                                        >
                                        High
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label for="status" class="form-label">
                                    Status
                                </label>

                                <select id="status" name="status" class="form-select" required>

                                    <option value="open" <%=report.status==='open' ? 'selected' : '' %>
                                        >
                                        Open
                                    </option>

                                    <option value="in-progress" <%=report.status==='in-progress' ? 'selected' : '' %>
                                        >
                                        In Progress
                                    </option>

                                    <option value="resolved" <%=report.status==='resolved' ? 'selected' : '' %>
                                        >
                                        Resolved
                                    </option>

                                    <option value="closed" <%=report.status==='closed' ? 'selected' : '' %>
                                        >
                                        Closed
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label for="assignedTo" class="form-label">
                                    Assigned To
                                </label>

                                <select id="assignedTo" name="assignedTo" class="form-select" required>

                                    <% users.forEach(user=> { %>

                                        <option value="<%= user._id %>"
                                            <%=report.assignedTo.toString()===user._id.toString() ? 'selected' : '' %>
                                            >
                                            <%= user.name %>
                                        </option>

                                        <% }) %>

                                </select>

                            </div>

                        </div>


                        <button type="submit" class="btn btn-primary">
                            Update Report
                        </button>

                        <a href="/reports" class="btn btn-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <%- include('../../partials/footer') %>