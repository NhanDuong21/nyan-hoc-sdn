%>
<%- include('../../partials/header') %>

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="page-title mb-0">
            Reports
        </h2>

        <a href="/reports/create" class="btn btn-primary">
            Create Report
        </a>

    </div>


    <div class="card list-panel report-filters mb-3">
        <div class="card-body">
            <form action="/reports" method="GET">
                <div class="d-flex flex-wrap gap-2 align-items-end">
                    <div class="filter-project">
                        <label for="filter-project" class="visually-hidden">Project</label>
                        <input type="text" id="filter-project" name="project" class="form-control"
                            placeholder="Project" value="<%= filters.project %>">
                    </div>
                    <div class="filter-select">
                        <label for="filter-status" class="visually-hidden">Status</label>
                        <select id="filter-status" name="status" class="form-select">
                            <option value="" <%= filters.status === '' ? 'selected' : '' %>>All Status</option>
                            <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open</option>
                            <option value="in-progress" <%= filters.status === 'in-progress' ? 'selected' : '' %>>In Progress</option>
                            <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                            <option value="closed" <%= filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
                        </select>
                    </div>
                    <div class="filter-select">
                        <label for="filter-severity" class="visually-hidden">Severity</label>
                        <select id="filter-severity" name="severity" class="form-select">
                            <option value="" <%= filters.severity === '' ? 'selected' : '' %>>All Severity</option>
                            <option value="low" <%= filters.severity === 'low' ? 'selected' : '' %>>Low</option>
                            <option value="medium" <%= filters.severity === 'medium' ? 'selected' : '' %>>Medium</option>
                            <option value="high" <%= filters.severity === 'high' ? 'selected' : '' %>>High</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-secondary">Filter</button>
                        <a href="/reports" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card list-panel">

        <div class="card-body">

            <% if (reports.length===0) { %>

                <div class="alert alert-info mb-0">
                    <%= filters.project || filters.status || filters.severity
                        ? 'No reports match the selected filters.' : 'No reports found.' %>
                </div>

                <% } else { %>

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle mb-0">

                            <thead>

                                <tr>
                                    <th>Title</th>
                                    <th>Project</th>
                                    <th>Severity</th>
                                    <th>Status</th>
                                    <th>Assigned To</th>
                                    <th>Created At</th>
                                    <th>Actions</th>
                                </tr>

                            </thead>

                            <tbody>

                                <% reports.forEach(report=> { %>

                                    <tr>

                                        <td>
                                            <%= report.title %>
                                        </td>

                                        <td>
                                            <%= report.project || '-' %>
                                        </td>

                                        <td>
                                            <%= report.severity %>
                                        </td>

                                        <td>
                                            <%= report.status %>
                                        </td>

                                        <td>

                                            <% if (report.assignedTo) { %>

                                                <%= report.assignedTo.name %>

                                                    <% } else { %>

                                                        Unassigned

                                                        <% } %>

                                        </td>

                                        <td>
                                            <%= new Date(report.createdAt).toLocaleString() %>
                                        </td>

                                        <td>

                                            <a href="/reports/edit/<%= report._id %>"
                                                class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <form action="/reports/delete/<%= report._id %>" method="POST"
                                                class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>

                                        </td>

                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <% } %>

        </div>

    </div>

    <%- include('../../partials/footer') %>
